# Copia este archivo a .env y completa los valores. .env NO se sube al repositorio.
# Guía paso a paso: docs/firebase-y-captcha.md

# Puertos (en esta máquina el 8080 lo ocupa otro contenedor)
PUERTO=8090
PUERTO_ADMIN=8091
PUERTO_DB=5433
PUERTO_REDIS=6380
PUERTO_HTTPS=8443

# PostgreSQL (obligatoria). Usa una clave larga aleatoria, p. ej.: openssl rand -hex 24
POSTGRES_PASSWORD=

# URL pública de la app (enlaces compartidos en Facebook y WhatsApp)
URL_PUBLICA=
# 1 en producción con HTTPS (cookie de sesión del panel con Secure)
COOKIE_SEGURA=0

# Cloudflare Turnstile (captcha del ingreso al panel). Vacío = claves de prueba (siempre pasan; solo desarrollo)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Firebase Cloud Messaging (web push a la app ciudadana). Vacío = push apagado.
# La cuenta de servicio va como archivo en secretos/firebase-cuenta-servicio.json
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
