{
  "name": "yaguachi-weather-panel",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Panel del analista de Yaguachi Weather (React + TypeScript + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "qa": "npm run typecheck && npm run lint && npm run test && vite build"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "leaflet.heat": "0.2.0",
    "leaflet.markercluster": "1.5.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.heat": "0.2.5",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
