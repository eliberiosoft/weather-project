{
  "name": "yaguachi-weather-cliente",
  "private": true,
  "version": "2.0.0",
  "description": "Yaguachi Weather · PWA ciudadana (React + TypeScript + Vite + Tailwind v4)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "qa": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@firebase/app": "0.16.5",
    "@firebase/messaging": "0.13.3",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
